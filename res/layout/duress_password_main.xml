<ScrollView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:clipToPadding="false"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="24dp"
        android:paddingTop="12dp"
        android:paddingEnd="24dp"
        android:paddingBottom="32dp">

        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="24dp"
            app:cardBackgroundColor="@color/settingslib_materialColorSurfaceContainerHigh"
            app:cardCornerRadius="28dp"
            app:cardElevation="0dp"
            app:strokeWidth="0dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="24dp">

                <ImageView
                    android:layout_width="32dp"
                    android:layout_height="32dp"
                    android:layout_marginBottom="20dp"
                    android:contentDescription="@null"
                    android:src="@drawable/ic_lock"
                    android:tint="?android:attr/colorAccent" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="8dp"
                    android:text="@string/duress_pwd_info_title"
                    android:textAppearance="@style/TextAppearance.SettingsLib.TitleLarge.Emphasized" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/duress_pwd_description"
                    android:textAppearance="@style/TextAppearance.SettingsLib.BodyLarge" />

            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <com.google.android.material.button.MaterialButton
            android:id="@+id/duress_password_add"
            style="@style/SettingsLibButtonStyle.Expressive.Filled.Extra"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/duress_pwd_action_add"
            app:icon="@drawable/ic_add_24dp" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/duress_password_update"
            style="@style/SettingsLibButtonStyle.Expressive.Filled.Extra"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/duress_pwd_action_update"
            android:visibility="gone"
            app:icon="@drawable/ic_edit" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/duress_password_delete"
            style="@style/SettingsLibButtonStyle.Expressive.Outline.Extra"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:text="@string/duress_pwd_action_delete"
            android:visibility="gone"
            app:icon="@drawable/ic_delete" />

    </LinearLayout>
</ScrollView>
